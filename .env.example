# Supabase Public Configuration (Required for Frontend)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Port for local Node dev server (Default: 3000)
PORT=3000

# Optional: Initial Admin Seed Helper (Only used by scripts/seed-admin.js)
# NEVER expose this SERVICE_ROLE key to the frontend client!
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# ADMIN_EMAIL=cse@drivehub.local
# ADMIN_PASSWORD=n2027
